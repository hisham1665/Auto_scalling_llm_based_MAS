# Cloud providers (NVIDIA is tried first; Groq is used after an NVIDIA error)
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_TIMEOUT=90
NVIDIA_RETRIES=0
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3-32b
GROQ_TIMEOUT=90
GROQ_RETRIES=0
CLOUD_REASONING_FORMAT=hidden

# Laptop-safe generation controls
LLM_TEMPERATURE=0.2
MAX_RESPONSE_TOKENS=384
MAX_TURNS=10
MAX_AGENTS=8
MAX_AGENT_GENERATIONS_PER_RUN=4
CONTEXT_MAX_CHARS=12000
RANDOM_SEED=42
RUNS_PER_CONFIGURATION=1
FEW_SHOT_EXAMPLES=2

# Output/evaluation
RESULTS_DIR=results
PROMPTS_DIR=prompts
EVALUATION_MODEL=distilbert-base-uncased
ENABLE_BERTSCORE=false
LOG_LEVEL=INFO
